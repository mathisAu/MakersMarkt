<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Pages.Moderator.ModeratorPanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Pages.Moderator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- NavigationView vult het meeste -->
            <RowDefinition Height="Auto"/>
            <!-- Voor de button onderaan -->
        </Grid.RowDefinitions>

        <!-- NavigationView -->
        <NavigationView x:Name="AdminNavView"
                    Grid.Row="0"
                    PaneDisplayMode="Left"
                    IsSettingsVisible="False"
                    SelectionChanged="AdminNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home"/>
                <NavigationViewItem Content="Gebruikers" Tag="Users" Icon="Contact"/>
                <NavigationViewItem Content="Producten" Tag="Products" Icon="Shop"/>
                <NavigationViewItem Content="Rapportages" Tag="Reports" Icon="ReportHacked"/>
            </NavigationView.MenuItems>

            <Frame x:Name="AdminContentFrame" Margin="24"/>
        </NavigationView>

        <!-- Uitloggen knop onderaan -->
        <Button x:Name="Uitloggen"
            Grid.Row="1"
            Content="Uitloggen"
            Click="Uitloggen_Click"
            Margin="24"/>
    </Grid>
</Page>
