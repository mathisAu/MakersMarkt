<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MakersMarkt.Pages.Login.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MakersMarkt.Pages.Login"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="350"
                Padding="30"
                CornerRadius="8"
                BorderThickness="1">
            <StackPanel Spacing="15">

                <TextBlock Text="MakersMarkt"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Inloggen"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="usernameTextBox"
                         Header="Gebruikersnaam"
                         PlaceholderText="Voer je gebruikersnaam in"/>

                <PasswordBox x:Name="passwordBox"
                             Header="Wachtwoord"
                             PlaceholderText="Voer je wachtwoord in"/>

                <TextBlock x:Name="ErrorMessage"
                           Text=""
                           Foreground="Red"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <Button x:Name="LoginButton"
                        Content="Inloggen"
                        HorizontalAlignment="Stretch"
                        Click="LoginButton_Click"
                        Margin="0,10,0,0"/>

                <HyperlinkButton Click="RegisterLink_Click"
                                 HorizontalAlignment="Center">
                    Nog geen account? Registreer hier.
                </HyperlinkButton>

            </StackPanel>
        </Border>
    </Grid>
</Page>